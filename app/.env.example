# Copy to .env. See src/lib/api.ts - the app renders on both the server and the
# client, so the API is reached at two different addresses.

# Browser -> API. Baked in at build time. Leave unset in local development: the
# Vite dev server proxies /api to http://localhost:8080 (see vite.config.ts), so
# the browser stays on one origin and never hits CORS. Set this to the API's
# public origin for a real deployment.
# VITE_API_URL=https://api.example.com

# Server -> API. Read at runtime during SSR and in route loaders, so it needs an
# absolute URL. Defaults to http://localhost:8080. In containers this is the
# compose service name, e.g. http://api:8080.
# API_INTERNAL_URL=http://localhost:8080

# Port the built server listens on (node .output/server/index.mjs).
# PORT=3000

# Shown under the sign-in card and in the app footer, next to the API's own
# version. Baked in at build time; the line is hidden when unset, so local
# development shows nothing rather than a fake version.
# VITE_APP_VERSION=0.1.0

# Copy to .env and adjust as needed. Loaded automatically by both
# `docker compose` (for the Postgres service in docker-compose.yml) and the Rust
# API (via dotenvy) when run locally.

# Used by the API and the migration CLI to connect to Postgres. Matches the
# docker-compose.yml defaults below - keep them in sync if you change
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB/POSTGRES_PORT.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tomely

# Optional overrides for the docker-compose.yml postgres service.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=tomely
# POSTGRES_PORT=5432

# Port the API listens on. Defaults to 8080, which is what the web app's dev
# proxy targets.
# PORT=8080

# Comma-separated browser origins allowed to call the API. Unset means "any",
# which is fine locally because the Vite dev server proxies /api so requests are
# same-origin anyway. Set it to the web app's real origin in a deployment.
# CORS_ORIGIN=https://tomely.example.com

# RUST_LOG=tomely_api=debug,tower_http=debug,info
